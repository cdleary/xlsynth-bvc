# Limit effort spent proving individual SAT-sweeping candidates in large circuits.
# An exhausted budget skips a merge; it does not weaken the required proof.

proc
opt
techmap
abc -g AND -script "+strash;&get -n;&fraig -x -C 10000;&put;scorr;dc2;dretime;strash;&get -n;&dch -f;&nf;&put"
clean
