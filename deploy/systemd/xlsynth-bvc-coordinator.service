# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=xlsynth-bvc release campaign coordinator
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=xlsynth-bvc
Group=xlsynth-bvc
WorkingDirectory=/opt/xlsynth-bvc
EnvironmentFile=/etc/xlsynth-bvc/coordinator.env
ExecStart=/opt/xlsynth-bvc/scripts/run-release-coordinator.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
